# Copy to `.env.local` (gitignored) and adjust to point Vite's dev proxy at any backend.
# Default when unset: http://127.0.0.1:5080 (local docker-compose backend).

# Remote backend on the LAN (replace host/port with your own):
BACKEND_URL=http://YOUR_BACKEND_HOST:1234

# The bearer token is set via the SPA's "Auth" popover in the top bar; it lives
# in localStorage (key: hwInventory.authToken) and is NOT read from this file.
