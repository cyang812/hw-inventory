# keep build context small + reproducible

# VCS / IDE
.git
.gitignore
.github
.vscode
.idea
*.code-workspace

# dev artifacts — must rebuild inside the image
frontend/node_modules
frontend/dist
frontend/.vite
backend/**/bin
backend/**/obj
backend/**/.vs

# runtime data — never bake into the image
data
*.db
*.db-shm
*.db-wal

# local env / overrides
.env
.env.*
!.env.example
compose.override.yml
docker-compose.override.yml

# misc
**/*.log
**/*.tmp
**/.DS_Store
**/Thumbs.db
