# Owner segment of the GHCR image path: ghcr.io/<GHCR_OWNER>/hw-inventory.
# Use your GitHub username or org name in lowercase.
GHCR_OWNER=changeme

# Tag to pull. Use a specific :sha-xxxxxxx for pinned/reproducible deploys.
IMAGE_TAG=latest

# REQUIRED in production (compose default). Long random string; treat as a password.
#   PowerShell:  -join ((33..126) | Get-Random -Count 48 | % { [char]$_ })
#   Linux:       openssl rand -base64 36
AUTH_TOKEN=

# "production" enables the safety guard: the API refuses to start without AUTH_TOKEN
# and without a non-loopback BIND_ADDRESS. Set to "development" only for local poking.
APP_ENV=production

# Days of inactivity after which a hardware item is surfaced as "idle".
IDLE_DEFAULT_DAYS=90

# Host port the SPA + API listen on. Container internally always uses 5080.
HOST_PORT=8080

# Optional: enable live gRPC by exposing a dedicated HTTP/2-only port.
# Leave unset to disable the live gRPC surface (integration tests cover it in-process).
# Plain HTTP can't ALPN-negotiate, so gRPC requires its own h2c endpoint.
#   Container example: http://0.0.0.0:5081  (also map a HOST_GRPC_PORT in compose).
#GRPC_BIND_ADDRESS=http://0.0.0.0:5081
